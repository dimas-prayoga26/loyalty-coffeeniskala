APP_NAME="Niskala Loyalty"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://system-loyalty-niskala.test
# POS timestamps (orders.order_date) are written in WIB by MySQL.
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# php artisan serve: 0.0.0.0 makes it reachable from other devices on the
# local network (http://<this PC's IP>:8000). 127.0.0.1 = this PC only.
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8000

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Existing POS database. Loyalty tables are created inside it with the
# loyalty_ prefix; POS tables are never altered. Must be the same database
# as pos-backend's DB_NAME (stamps point at its orders).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos_live_raw
DB_USERNAME=root
DB_PASSWORD=
DB_COLLATION=utf8mb4_0900_ai_ci

LOYALTY_STAMPS_PER_CARD=10
# An order earns a stamp from this total (total_with_tax, rupiah).
LOYALTY_STAMP_MIN_ORDER_TOTAL=25000
# Stamps a phone number can earn per day (by order date, WIB); 0: no limit.
LOYALTY_MAX_STAMPS_PER_DAY=1
# Demo/test numbers accepted although not a real mobile number (demo only).
LOYALTY_TEST_NUMBERS=

# Shared secret for /api/pos/*: the same value as LOYALTY_API_TOKEN in
# pos-backend/.env. Generate with: php -r "echo bin2hex(random_bytes(32));"
LOYALTY_POS_API_TOKEN=

# Cloudflare Turnstile for /verify. These are Cloudflare's official test keys
# (always pass), for local development only. In production use the real keys
# from the Cloudflare dashboard (Turnstile > loyalty.coffeeniskala.com).
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# File/sync drivers: no extra non-loyalty tables in the POS database.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
